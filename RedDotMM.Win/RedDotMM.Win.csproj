<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<Version>0.0.3</Version>
	<ApplicationIcon>Ressources\Images\red_dot_shooting_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Control\ScheibenControl.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Ressources\Images\red_dot_shooting_icon.ico" />
    <None Remove="Ressources\Images\red_dot_shooting_icon.png" />
    <None Remove="Ressources\Images\splash.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Control\ScheibenControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ressources\Images\red_dot_shooting_icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedDotMM.CommonHelper\RedDotMM.CommonHelper.csproj" />
    <ProjectReference Include="..\RedDotMM.Empfaenger\RedDotMM.Empfaenger.csproj" />
    <ProjectReference Include="..\RedDotMM.Logger\RedDotMM.Logger.csproj" />
    <ProjectReference Include="..\RedDotMM.Model\RedDotMM.Model.csproj" />
    <ProjectReference Include="..\RedDotMM.Web\RedDotMM.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Control\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Ressources\Images\red_dot_shooting_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <SplashScreen Include="Ressources\Images\splash.jpeg" />
  </ItemGroup>

</Project>
